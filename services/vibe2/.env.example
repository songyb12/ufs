# VIBE 2.0 Environment Variables

# Anthropic API key for LLM briefing generation
ANTHROPIC_API_KEY=

# Database (default: SQLite local file)
DATABASE_URL=sqlite:///./vibe2.db

# JWT authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Data collection
SOXL_SYMBOLS=["SOXL","SOXX","^SOX","^VIX","^TNX","DX-Y.NYB"]
UPDATE_INTERVAL_MINUTES=30

# Logging
LOG_LEVEL=INFO
